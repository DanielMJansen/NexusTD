{
  "name": "nexus",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "docs:values": "esbuild scripts/gen-values.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-values.mjs --log-level=warning && node node_modules/.cache/gen-values.mjs",
    "calib": "esbuild scripts/calib.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/calib.mjs --log-level=warning && node node_modules/.cache/calib.mjs",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "calib:matrix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/calib-matrix.ps1",
    "i18n:check": "node scripts/i18n-check.mjs && npm run -s i18n:extract -- --check",
    "i18n:extract": "esbuild scripts/i18n-extract.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/i18n-extract.mjs --log-level=warning && node node_modules/.cache/i18n-extract.mjs",
    "release:itch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-itch.ps1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
