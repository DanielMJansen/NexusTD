{
  "name": "nexus",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "docs:values": "esbuild scripts/gen-values.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-values.mjs --log-level=warning && node node_modules/.cache/gen-values.mjs",
    "calib": "esbuild scripts/calib.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/calib.mjs --log-level=warning && node node_modules/.cache/calib.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
